{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syphon",
  "version": "0.1.3",
  "identifier": "com.syphon.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Syphon",
        "width": 1500,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  }
}
